# Claude API key (console.anthropic.com), or run `ant auth login` instead.
ANTHROPIC_API_KEY=

# Beeper Desktop → Settings → Developers → create an access token.
BEEPER_ACCESS_TOKEN=

# Optional: Google Cloud console → enable YouTube Data API v3 → create an API key.
YOUTUBE_API_KEY=

# Optional: create a bot with @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
